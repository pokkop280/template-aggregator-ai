{
    "cli": {
        "version": ">= 3.10.2"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "ios": {
                "simulator": false,
                "buildConfiguration": "Debug"
            }
        },
        "preview": {
            "distribution": "internal",
            "ios": {
                "simulator": false,
                "enterpriseProvisioning": "adhoc",
                "buildConfiguration": "Release"
            },
            "channel": "preview"
        },
        "production": {
            "distribution": "internal",
            "ios": {
                "simulator": false,
                "enterpriseProvisioning": "adhoc",
                "buildConfiguration": "Release"
            },
            "channel": "production"
        }
    },
    "submit": {
        "production": {}
    }
}